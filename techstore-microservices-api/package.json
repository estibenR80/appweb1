{
  "name": "techstore-microservices",
  "version": "1.0.0",
  "description": "Prototipo de API de tienda online con arquitectura de microservicios - Taller Semana 8",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "seed": "node shared/seed.js",
    "start": "node start-all.js",
    "start:gateway": "node gateway/src/server.js",
    "start:auth": "node services/auth/src/server.js",
    "start:catalog": "node services/catalog/src/server.js",
    "start:cart": "node services/cart/src/server.js",
    "start:payment": "node services/payment/src/server.js",
    "start:shipping": "node services/shipping/src/server.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "http-proxy-middleware": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.14.2",
    "yamljs": "^0.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "setupFiles": ["<rootDir>/tests/setup.js"]
  }
}
