# Configuración de ejemplo. Copie a .env y ajuste los valores.
NODE_ENV=development

# Seguridad
JWT_SECRET=cambie-esta-clave-en-produccion
JWT_EXPIRES_IN=2h

# Base de datos
DB_FILE=./data/techstore.db

# Puertos
GATEWAY_PORT=8080
AUTH_PORT=3001
CATALOG_PORT=3002
CART_PORT=3003
PAYMENT_PORT=3004
SHIPPING_PORT=3005

# URLs internas (para Docker Compose usar el nombre del servicio como host)
AUTH_URL=http://localhost:3001
CATALOG_URL=http://localhost:3002
CART_URL=http://localhost:3003
PAYMENT_URL=http://localhost:3004
SHIPPING_URL=http://localhost:3005

# Observabilidad
LOG_LEVEL=info
